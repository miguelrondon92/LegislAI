# Production Environment Configuration Template
# Copy this file to .env and update values for production deployment

# Flask environment variables
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=false
LOG_LEVEL=WARNING
SESSION_SECRET=your-secure-random-secret-key-here

# Notification Settings
# Set to 'true' to enable notifications in production (default: disabled)
NOTIFICATIONS_ENABLED=false

# Database Configuration (Production)
DATABASE_URL=postgresql://username:password@host:port/database_name

# API Keys (Store in secure environment variables or secrets manager)
CONGRESS_API_KEY=your-congress-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
CLAUDE_API_KEY=your-claude-api-key

# Production Email Configuration
# Option 1: SendGrid (Recommended)
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Option 2: Amazon SES
# MAIL_SERVER=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=your-ses-smtp-username
# MAIL_PASSWORD=your-ses-smtp-password
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Admin credentials (ops logs / workflow — sign in with these)
LEGISLAI_ADMIN_USERNAME=your-admin-username
LEGISLAI_ADMIN_PASSWORD=your-secure-admin-password

# Additional Production Settings
BASE_URL=https://yourdomain.com
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Optional: Redis for caching (if implemented)
# REDIS_URL=redis://localhost:6379/0

# Optional: Monitoring and observability
# SENTRY_DSN=your-sentry-dsn
# APM_SERVICE_NAME=legislai-production