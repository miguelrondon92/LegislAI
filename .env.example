# LegislAI environment template
# Copy to .env and fill in real values. Never commit .env.

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# APIs
CONGRESS_API_KEY=your-congress-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
CLAUDE_API_KEY=your-claude-api-key

# Database (optional; defaults to local SQLite)
# DATABASE_URL=postgresql://username:password@host:port/database_name

# Email (optional)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password-or-app-password
MAIL_DEFAULT_SENDER=noreply@example.com

# Admin (ops logs / workflow — sign in with these credentials)
LEGISLAI_ADMIN_USERNAME=your-admin-username
LEGISLAI_ADMIN_PASSWORD=your-secure-admin-password

# Notifications (end-user bill alerts)
NOTIFICATIONS_ENABLED=false

# Ops alerts (programmer) — independent of NOTIFICATIONS_ENABLED
# Primary: in-app Ops logs at /ops/logs (admin sign-in required; persisted OpsAlert rows).
# Optional email: point OPS_ALERT_WEBHOOK_URL at Zapier/Make/n8n/IFTTT.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERTS_ENABLED=true
OPS_ALERT_COOLDOWN_SECONDS=1800
