{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start-context.sh",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/block-secrets-read.sh",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-secrets-shell.sh",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/block-secrets-tool.sh",
        "matcher": "Read|Write|Edit|TabRead|TabWrite",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/block-secrets-prompt.sh",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/pipeline-subagent-stop.sh",
        "timeout": 15,
        "loop_limit": 4
      }
    ]
  }
}
